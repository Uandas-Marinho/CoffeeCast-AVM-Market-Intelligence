        "import pandas as pd\n",
        "import yfinance as yf\n",
        "\n",
        "print(\"--- COFFEECAST: INGESTÃO DE DADOS DE MERCADO ---\")\n",
        "\n",
        "tickers = [\"KC=F\", \"USDBRL=X\"]\n",
        "\n",
        "print(f\"Baixando dados históricos para: {tickers} ...\")\n",
        "\n",
        "dados = yf.download(tickers, period=\"2y\", interval=\"1d\")['Close']\n",
        "dados = dados.dropna()\n",
        "\n",
        "print(\"\\nPrimeiras linhas dos dados brutos coletados:\")\n",
        "print(dados.head())\n",
        "\n",
        "print(\"\\nÚltimas linhas (dados mais recentes):\")\n",
        "print(dados.tail())\n",
        "\n",
        "dados.to_csv(\"dados_cafe_mercado.csv\")\n",
        "print(\"\\n[Sucesso!] Arquivo 'dados_cafe_mercado.csv' salvo com sucesso no Colab.\")"
