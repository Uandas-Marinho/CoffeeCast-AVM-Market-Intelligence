import pandas as pd
import matplotlib.pyplot as plt
import io
import base64
import ipywidgets as widgets
from IPython.display import display, clear_output

# 1. Carregar e processar os dados
try:
    df = pd.read_csv("dados_cafe_mercado.csv", index_col="Date", parse_dates=True)
except FileNotFoundError:
    import yfinance as yf
    df = yf.download(["KC=F", "USDBRL=X"], period="2y")['Close'].dropna()
    df.to_csv("dados_cafe_mercado.csv")

df['Cafe_USD_Saca'] = (df['KC=F'] / 100) * 132.2773
df['Cafe_BRL_Saca'] = df['Cafe_USD_Saca'] * df['USDBRL=X']

# 2. Layout visual do Topo (Estilo Mobile)
titulo_html = """
<div style='background-color: #4A3B32; padding: 15px; border-radius: 10px; text-align: center; color: white; font-family: sans-serif; margin-bottom: 15px;'>
    <h2 style='margin: 0;'>☕ CoffeeCast Mobile (Estático)</h2>
    <p style='margin: 5px 0 0 0; font-size: 14px; opacity: 0.9;'>Compatibilidade Máxima Ativada</p>
</div>
"""

ultimo_cafe_brl = df['Cafe_BRL_Saca'].iloc[-1]
ultimo_dolar = df['USDBRL=X'].iloc[-1]
ultima_data = df.index[-1].strftime('%d/%m/%Y')

cards_html_template = """
<div style='display: flex; justify-content: space-around; font-family: sans-serif; margin-bottom: 10px;'>
    <div style='background: #f4f1ea; padding: 12px; border-radius: 8px; border-left: 5px solid #8B5A2B; min-width: 140px; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.05);'>
        <span style='font-size: 11px; color: #666; text-transform: uppercase;'>Saca de Café</span>
        <h3 style='margin: 5px 0; color: #8B5A2B;'>R$ {cafe:,.2f}</h3>
    </div>
    <div style='background: #f4f1ea; padding: 12px; border-radius: 8px; border-left: 5px solid #2E8B57; min-width: 140px; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.05);'>
        <span style='font-size: 11px; color: #666; text-transform: uppercase;'>Câmbio Comercial</span>
        <h3 style='margin: 5px 0; color: #2E8B57;'>R$ {dolar:,.4f}</h3>
    </div>
</div>
<p style='text-align: center; font-size: 11px; color: #999; font-family: sans-serif; margin-bottom: 15px;'>Última atualização: {data}</p>
"""

# 3. Componentes de Controle de Interface
periodo_botoes = widgets.ToggleButtons(
    options=['30 Dias', '6 Meses', '1 Ano', 'Todo o Período'],
    value='6 Meses',
    description='Período:',
    style={'button_width': '90px'}
)

painel_saida = widgets.Output()

# 4. Função para gerar gráfico estático em alta resolução e converter para HTML
def gerar_grafico_estatico(df_filtrado):
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(6, 5.5), sharex=True, dpi=110)
    
    # Subplot 1: Café
    ax1.plot(df_filtrado.index, df_filtrado['Cafe_BRL_Saca'], color='#8B5A2B', linewidth=2, label='Café (R$)')
    ax1.set_title('Preço Estimado da Saca de Café (R$)', fontsize=10, fontweight='bold', color='#4A3B32')
    ax1.grid(True, linestyle='--', alpha=0.5, color='#ccc')
    ax1.set_facecolor('#fafafa')
    
    # Subplot 2: Câmbio
    ax2.plot(df_filtrado.index, df_filtrado['USDBRL=X'], color='#2E8B57', linewidth=2, label='Dólar (R$)')
    ax2.set_title('Taxa de Câmbio (USD/BRL)', fontsize=10, fontweight='bold', color='#2E8B57')
    ax2.grid(True, linestyle='--', alpha=0.5, color='#ccc')
    ax2.set_facecolor('#fafafa')
    
    plt.tight_layout()
    
    # Salvar em buffer de memória e codificar em Base64
    buf = io.BytesIO()
    plt.savefig(buf, format='png', bbox_inches='tight')
    plt.close(fig)
    buf.seek(0)
    image_base64 = base64.b64encode(buf.read()).decode('utf-8')
    return f'<div style="text-align: center; margin-top: 10px;"><img src="data:image/png;base64,{image_base64}" style="max-width: 100%; border-radius: 8px;" /></div>'

# 5. Função de atualização dinâmica do painel unificado
def renderizar_painel(change):
    with painel_saida:
        clear_output(wait=True)
        
        opcao = periodo_botoes.value
        if opcao == '30 Dias':
            df_filtrado = df.tail(30)
        elif opcao == '6 Meses':
            df_filtrado = df.tail(126)
        elif opcao == '1 Ano':
            df_filtrado = df.tail(252)
        else:
            df_filtrado = df
            
        # Gerar o gráfico incorporado
        grafico_html = gerar_grafico_estatico(df_filtrado)
        
        # HTML Final consolidado contendo os dados
        painel_html = widgets.HTML(
            value=f"""
            <div style='max-width: 450px; border: 1px solid #ccc; border-radius: 12px; padding: 15px; margin: auto; box-shadow: 0px 4px 15px rgba(0,0,0,0.1); background-color: white;'>
                {titulo_html}
                {cards_html_template.format(cafe=ultimo_cafe_brl, dolar=ultimo_dolar, data=ultima_data)}
                <hr style='border: 0; border-top: 1px solid #eee; margin: 15px 0;'>
                <div style='display: flex; justify-content: center; margin-bottom: 10px;'>
                    <!-- Botões controlados externamente via widgets -->
                </div>
                {grafico_html}
            </div>
            """
        )
        display(painel_html)

# Ligar eventos
periodo_botoes.observe(renderizar_painel, names='value')

# Primeira renderização
renderizar_painel(None)

# Exibir a estrutura na ordem correta
display(periodo_botoes)
display(painel_saida)
