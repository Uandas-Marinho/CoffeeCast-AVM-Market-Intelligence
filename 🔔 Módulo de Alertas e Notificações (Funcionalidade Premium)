import ipywidgets as widgets
from IPython.display import display, clear_output

class GerenciadorAlertas:
    def __init__(self, df):
        self.df = df
        self.alertas_ativos = []
        
        # Elementos de UI
        self.moeda_seletor = widgets.Dropdown(
            options={'Saca de Café (R$)': 'Cafe_BRL_Saca', 'Câmbio Dólar (R$)': 'USDBRL=X'},
            value='Cafe_BRL_Saca',
            description='Ativo:',
            style={'description_width': 'initial'}
        )
        self.condicao_seletor = widgets.Dropdown(
            options={'Maior ou Igual a (>=)': '>=', 'Menor ou Igual a (<=)': '<='},
            value='>=',
            description='Condição:',
            style={'description_width': 'initial'}
        )
        self.valor_limite = widgets.FloatText(
            value=2000.00,
            description='Valor Alvo (R$):',
            style={'description_width': 'initial'}
        )
        self.botao_criar = widgets.Button(
            description='Criar Alerta',
            button_style='success',
            icon='bell'
        )
        self.painel_alertas = widgets.Output()
        self.log_disparos = widgets.Output()
        
        self.botao_criar.on_click(self.criar_alerta_click)

    def renderizar_alertas(self):
        with self.painel_alertas:
            clear_output(wait=True)
            print("🔔 SEUS ALERTAS ATIVOS:")
            if not self.alertas_ativos:
                print("Nenhum alerta configurado no momento.")
            for i, alt in enumerate(self.alertas_ativos):
                nome_ativo = "Café" if alt['ativo'] == 'Cafe_BRL_Saca' else "Dólar"
                print(f"{i+1}. Notificar quando [{nome_ativo}] for {alt['condicao']} R$ {alt['valor']:.2f}")

    def criar_alerta_click(self, b):
        novo_alerta = {
            'ativo': self.moeda_seletor.value,
            'condicao': self.condicao_seletor.value,
            'valor': self.valor_limite.value
        }
        self.alertas_ativos.append(novo_alerta)
        self.renderizar_alertas()
        self.verificar_alertas()

    def verificar_alertas(self):
        with self.log_disparos:
            clear_output(wait=True)
            print("🔄 Verificando condições de mercado...")
            
            v_cafe = self.df['Cafe_BRL_Saca'].iloc[-1]
            v_dolar = self.df['USDBRL=X'].iloc[-1]
            
            valores_atuais = {
                'Cafe_BRL_Saca': v_cafe,
                'USDBRL=X': v_dolar
            }
            
            disparou_algum = False
            for alt in self.alertas_ativos:
                valor_atual = valores_atuais[alt['ativo']]
                nome_ativo = "Café ☕" if alt['ativo'] == 'Cafe_BRL_Saca' else "Dólar 💵"
                
                cond_atendida = False
                if alt['condicao'] == '>=' and valor_atual >= alt['valor']:
                    cond_atendida = True
                elif alt['condicao'] == '<=' and valor_atual <= alt['valor']:
                    cond_atendida = True
                    
                if cond_atendida:
                    disparou_algum = True
                    print(f"\n🚨 NOTIFICAÇÃO DISPARADA NO CELULAR!")
                    print(f"📱 Mensagem: O preço do {nome_ativo} atingiu R$ {valor_atual:,.2f} (Sua meta era {alt['condicao']} R$ {alt['valor']:,.2f})")
            
            if not disparou_algum:
                print("\n🟢 Tudo calmo. Nenhuma meta de preço foi atingida com as cotações atuais.")

    def exibir_interface(self):
        ui_criador = widgets.VBox([
            widgets.HTML("<h4>⚙️ Configurar Novo Alerta de Preço (Premium)</h4>"),
            widgets.HBox([self.moeda_seletor, self.condicao_seletor, self.valor_limite]),
            self.botao_criar
        ], layout=widgets.Layout(border='1px solid #ccc', padding='10px', border_radius='8px', margin='10px 0'))
        
        self.renderizar_alertas()
        display(ui_criador)
        display(self.painel_alertas)
        display(self.log_disparos)
