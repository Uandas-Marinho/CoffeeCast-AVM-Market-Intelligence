import ipywidgets as widgets
from IPython.display import display, clear_output

# Banco de dados simulado em memória para os alertas do usuário
alertas_ativos = []

# Componentes visuais para criação de Alertas
moeda_seletor = widgets.Dropdown(
    options={'Saca de Café (R$)': 'Cafe_BRL_Saca', 'Câmbio Dólar (R$)': 'USDBRL=X'},
    value='Cafe_BRL_Saca',
    description='Ativo:',
    style={'description_width': 'initial'}
)

condicao_seletor = widgets.Dropdown(
    options={'Maior ou Igual a (>=)': '>=', 'Menor ou Igual a (<=)': '<='},
    value='>=',
    description='Condição:',
    style={'description_width': 'initial'}
)

valor_limite = widgets.FloatText(
    value=2000.00,
    description='Valor Alvo (R$):',
    style={'description_width': 'initial'}
)

botao_criar = widgets.Button(
    description='Criar Alerta',
    button_style='success',
    icon='bell'
)

painel_alertas = widgets.Output()
log_disparos = widgets.Output()

def renderizar_alertas():
    with painel_alertas:
        clear_output(wait=True)
        print("🔔 SEUS ALERTAS ATIVOS:")
        if not alertas_ativos:
            print("Nenhum alerta configurado no momento.")
        for i, alt in enumerate(alertas_ativos):
            nome_ativo = "Café" if alt['ativo'] == 'Cafe_BRL_Saca' else "Dólar"
            print(f"{i+1}. Notificar quando [{nome_ativo}] for {alt['condicao']} R$ {alt['valor']:.2f}")

def criar_alerta_click(b):
    novo_alerta = {
        'ativo': moeda_seletor.value,
        'condicao': condicao_seletor.value,
        'valor': valor_limite.value
    }
    alertas_ativos.append(novo_alerta)
    renderizar_alertas()
    verificar_alertas_instantaneamente()

botao_criar.on_click(criar_alerta_click)

