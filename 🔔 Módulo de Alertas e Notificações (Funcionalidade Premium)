# Layout Visual do Criador de Alertas
ui_criador = widgets.VBox([
    widgets.HTML("<h4>⚙️ Configurar Novo Alerta de Preço</h4>"),
    widgets.HBox([moeda_seletor, condicao_seletor, valor_limite]),
    botao_criar
], layout=widgets.Layout(border='1px solid #ccc', padding='10px', border_radius='8px', margin='10px 0'))

# Primeira renderização do painel
renderizar_alertas()

